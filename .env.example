# Canvas Track Environment Configuration
# Copy this file to .env and fill in your details:
#   cp .env.example .env

# ==============================================================================
# Canvas LMS Configuration
# ==============================================================================
# Canvas LMS domain (e.g. school.instructure.com or canvas.university.edu)
CANVAS_DOMAIN=canvas.example.edu

# Canvas Personal Access Token
# Generate at: https://<your-canvas-domain>/profile/settings#access_tokens
CANVAS_TOKEN=

# Optional: Default site nickname / ID (defaults to sanitized domain name)
CANVAS_SITE_ID=canvas_main

# Optional: Canvas Course ID for CLI sync and test verification
CANVAS_COURSE_ID=12345

# Optional: Expected user verification for live test assertions
CANVAS_EXPECTED_USER_ID=
CANVAS_EXPECTED_USER_NAME=

# ==============================================================================
# Moodle LMS Configuration
# ==============================================================================
# Moodle LMS Base URL or Domain (e.g. https://moodle.university.edu)
MOODLE_URL=https://moodle.example.edu

# Moodle Web Service Token or Mobile SSO link / base64 string
MOODLE_TOKEN=

# Optional: Default site nickname / ID (defaults to sanitized domain name)
MOODLE_SITE_ID=moodle_main

# Optional: Moodle Course ID for CLI sync and live testing
MOODLE_COURSE_ID=67890

# Optional: Expected user verification for live test assertions
MOODLE_EXPECTED_USER_ID=
MOODLE_EXPECTED_USER_NAME=
